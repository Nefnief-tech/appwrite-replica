# Copy to .env and change every secret before exposing this stack.

POSTGRES_USER=openwrite
POSTGRES_PASSWORD=openwrite-dev
POSTGRES_DB=openwrite
REPLICATION_PASSWORD=openwrite-replication

ADMIN_EMAIL=admin@openwrite.local
ADMIN_PASSWORD=openwrite-dev-admin
SESSION_SECRET=change-me-openwrite-session-secret
NODE_SECRET=change-me-openwrite-node-secret

# Origin users reach the admin UI and Appwrite SDK through.
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
# leader: all reads hit the primary. replica: reads rotate over healthy followers.
READ_ROUTING=replica
